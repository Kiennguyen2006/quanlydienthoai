@{
    ViewData["Title"] = "Quản lý - KMNCA";
    Layout = null;

    string quyen = ViewBag.quyen?.ToString() ?? "";
    string tenDangNhap = ViewBag.tentk?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Quản lý - KMNCA</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f4f7fb;
            color: #333;
            overflow: hidden;
        }

        .header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 70px;
            background: linear-gradient(135deg, #007bff, #74c0fc);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 25px;
            color: white;
            z-index: 1000;
            box-shadow: 0 3px 10px rgba(0,0,0,0.15);
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .logo {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #007bff;
            font-weight: bold;
            font-size: 18px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.2);
        }

        .header-title {
            font-size: 22px;
            font-weight: bold;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .user-info {
            display: flex;
            flex-direction: column;
            text-align: right;
        }

        .user-info strong {
            font-size: 15px;
        }

        .user-info span {
            font-size: 13px;
            opacity: 0.9;
        }

        .logout-btn {
            text-decoration: none;
            color: white;
            padding: 9px 16px;
            border-radius: 7px;
            background: rgba(255,255,255,0.18);
            transition: 0.2s;
        }

        .logout-btn:hover {
            background: rgba(255,255,255,0.3);
        }

        .sidebar {
            position: fixed;
            top: 70px;
            left: 0;
            bottom: 0;
            width: 250px;
            background: #ffffff;
            border-right: 1px solid #ddd;
            overflow-y: auto;
            z-index: 900;
            padding: 18px 12px;
        }

        .menu-title {
            font-size: 12px;
            font-weight: bold;
            color: #888;
            margin: 15px 12px 8px;
            text-transform: uppercase;
        }

        .menu-link {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: #444;
            padding: 12px 14px;
            margin-bottom: 4px;
            border-radius: 8px;
            transition: all 0.2s;
        }

        .menu-link:hover {
            background: #eaf4ff;
            color: #007bff;
            transform: translateX(2px);
        }

        .menu-link.active {
            background: #007bff;
            color: white;
        }

        .menu-icon {
            width: 25px;
            text-align: center;
            font-size: 17px;
        }

        .main {
            position: fixed;
            top: 70px;
            left: 250px;
            right: 0;
            bottom: 0;
            overflow-y: auto;
            padding: 25px;
            background: #f4f7fb;
        }

        #page-content {
            width: 100%;
            min-height: 100%;
        }

        .welcome-card {
            background: white;
            border-radius: 14px;
            padding: 35px;
            box-shadow: 0 3px 15px rgba(0,0,0,0.07);
            margin-bottom: 20px;
        }

        .welcome-card h1 {
            color: #007bff;
            margin-bottom: 10px;
        }

        .welcome-card p {
            color: #666;
            line-height: 1.7;
        }

        .content-card {
            background: white;
            border-radius: 14px;
            padding: 25px;
            box-shadow: 0 3px 15px rgba(0,0,0,0.07);
        }

        .content-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            gap: 15px;
            flex-wrap: wrap;
        }

        .content-header h2 {
            color: #222;
        }

        .btn {
            display: inline-block;
            border: none;
            text-decoration: none;
            cursor: pointer;
            padding: 10px 17px;
            border-radius: 7px;
            font-size: 14px;
            transition: 0.2s;
        }

        .btn-primary {
            background: #007bff;
            color: white;
        }

        .btn-primary:hover {
            background: #0069d9;
        }

        .btn-success {
            background: #28a745;
            color: white;
        }

        .btn-success:hover {
            background: #218838;
        }

        .btn-warning {
            background: #ffc107;
            color: #212529;
        }

        .btn-warning:hover {
            background: #e0a800;
        }

        .btn-danger {
            background: #dc3545;
            color: white;
        }

        .btn-danger:hover {
            background: #c82333;
        }

        .btn-secondary {
            background: #6c757d;
            color: white;
        }

        .btn-secondary:hover {
            background: #5a6268;
        }

        .loading {
            background: white;
            border-radius: 14px;
            min-height: 250px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 15px;
            color: #777;
            box-shadow: 0 3px 15px rgba(0,0,0,0.07);
        }

        .loading-spinner {
            width: 40px;
            height: 40px;
            border: 4px solid #e5e5e5;
            border-top-color: #007bff;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        @@media (max-width: 900px) {

            .sidebar {
                width: 210px;
            }

            .main {
                left: 210px;
            }

            .header-title {
                font-size: 18px;
            }
        }

        @@media (max-width: 700px) {

            .sidebar {
                width: 65px;
                padding: 15px 7px;
            }

            .main {
                left: 65px;
            }

            .menu-title {
                display: none;
            }

            .menu-link {
                justify-content: center;
                padding: 13px 5px;
            }

            .menu-link span:not(.menu-icon) {
                display: none;
            }

            .header-title {
                display: none;
            }

            .user-info {
                display: none;
            }

            .main {
                padding: 15px;
            }
        }
        /* ================= FOOTER ================= */

.footer {
    margin-top: 30px;
    background: linear-gradient(135deg, #0069d9, #007bff, #74c0fc);
    color: white;
    border-radius: 16px 16px 0 0;
    overflow: hidden;
    box-shadow: 0 -3px 15px rgba(0, 0, 0, 0.08);
}

.footer-container {
    max-width: 1400px;
    margin: auto;
    padding: 35px 35px 20px;
}

.footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 35px;
}

.footer-column h3 {
    font-size: 18px;
    margin-bottom: 16px;
    font-weight: 700;
}

.footer-column p {
    font-size: 14px;
    line-height: 1.8;
    margin-bottom: 7px;
    color: rgba(255, 255, 255, 0.92);
}

.footer-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 15px;
}

.footer-logo {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: white;
    color: #007bff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 18px;
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.18);
}

.footer-brand-name {
    font-size: 21px;
    font-weight: bold;
}

.footer-description {
    max-width: 360px;
}

.footer-list {
    list-style: none;
    padding: 0;
    margin: 0;
}

.footer-list li {
    margin-bottom: 10px;
}

.footer-list a {
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    font-size: 14px;
    transition: 0.2s;
}

.footer-list a:hover {
    color: white;
    padding-left: 5px;
}

.footer-contact-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 12px;
}

.footer-contact-icon {
    width: 25px;
    flex-shrink: 0;
    text-align: center;
    font-size: 16px;
}

.footer-contact-item a {
    color: white;
    text-decoration: none;
}

.footer-contact-item a:hover {
    text-decoration: underline;
}

.footer-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.25);
    margin: 25px 0 18px;
}

.footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.88);
}

.footer-bottom-links {
    display: flex;
    gap: 20px;
}

.footer-bottom-links a {
    color: white;
    text-decoration: none;
}

.footer-bottom-links a:hover {
    text-decoration: underline;
}

@@media (max-width: 900px) {
    .footer-grid {
        grid-template-columns: 1fr 1fr;
    }
}

@@media (max-width: 600px) {
    .footer-container {
        padding: 25px 20px 18px;
    }

    .footer-grid {
        grid-template-columns: 1fr;
        gap: 25px;
    }

    .footer-bottom {
        flex-direction: column;
        align-items: flex-start;
    }

    .footer-bottom-links {
        flex-wrap: wrap;
        gap: 12px;
    }
}
    </style>
</head>

<body>

    <header class="header">

        <div class="header-left">

            <div class="logo">
                KM
            </div>

            <div class="header-title">
                HỆ THỐNG QUẢN LÝ
            </div>

        </div>

        <div class="header-right">

            <div class="user-info">

                <strong>
                    @tenDangNhap
                </strong>

                <span>
                    @quyen
                </span>

            </div>
        </div>

    </header>


    <aside class="sidebar">

        <div class="menu-title">
            Tổng quan
        </div>

        <a href="@Url.Action("Quanly", "Quanly")"
           class="menu-link ajax-menu">

            <span class="menu-icon">🏠</span>

            <span>Trang chủ</span>

        </a>


        <div class="menu-title">
            Quản lý
        </div>


        <a href="@Url.Action("Index", "KhachHang")"
           class="menu-link ajax-menu">

            <span class="menu-icon">👥</span>

            <span>Khách hàng</span>

        </a>


        <a href="@Url.Action("Index", "SanPham")"
           class="menu-link ajax-menu">

            <span class="menu-icon">📱</span>

            <span>Sản phẩm</span>

        </a>


        <a href="@Url.Action("Index", "HoaDon")"
           class="menu-link ajax-menu">

            <span class="menu-icon">🧾</span>

            <span>Hóa đơn</span>

        </a>


        @if (quyen == "Admin")
        {
            <a href="@Url.Action("Index", "NhanVien")"
               class="menu-link ajax-menu">

                <span class="menu-icon">👨‍💼</span>

                <span>Nhân viên</span>

            </a>
        }


        @if (quyen == "Admin")
        {
            <a href="@Url.Action("Index", "ChiTietHoaDon")"
               class="menu-link ajax-menu">

                <span class="menu-icon">📄</span>

                <span>Chi tiết hóa đơn</span>

            </a>
        }


        @if (quyen == "Admin")
        {
            <a href="@Url.Action("Index", "NhaCungCap")"
               class="menu-link ajax-menu">

                <span class="menu-icon">🏢</span>

                <span>Nhà cung cấp</span>

            </a>
        }


        @if (quyen == "Admin")
        {
            <a href="@Url.Action("Index", "TaiKhoan")"
               class="menu-link ajax-menu">

                <span class="menu-icon">🔐</span>

                <span>Tài khoản</span>

            </a>
        }


        <div class="menu-title">
            Hệ thống
        </div>


        <a href="@Url.Action("Dangxuat", "Kiemtrathongtin")"
           class="menu-link logout-btn">

            <span class="menu-icon">🚪</span>

            <span>Đăng xuất</span>

        </a>

    </aside>


 <main class="main">

    <div id="page-content">

        <div class="welcome-card">

            <h1>
                Xin chào, @tenDangNhap!
            </h1>

            <p>
                Chào mừng bạn đến với hệ thống quản lý cửa hàng điện thoại.
                Hãy chọn chức năng ở menu bên trái để bắt đầu quản lý.
            </p>

            <br />

            <p>
                Quyền hiện tại:
                <strong>@quyen</strong>
            </p>

        </div>

    </div>


    <!-- FOOTER -->
    <footer class="footer">

        <div class="footer-container">

            <div class="footer-grid">

                <!-- THÔNG TIN CÔNG TY -->
                <div class="footer-column">

                    <div class="footer-brand">

                        <div class="footer-logo">
                            KM
                        </div>

                        <div class="footer-brand-name">
                            KMNCA
                        </div>

                    </div>

                    <p class="footer-description">
                        Hệ thống quản lý cửa hàng điện thoại KMNCA,
                        hỗ trợ quản lý sản phẩm, khách hàng, nhân viên,
                        hóa đơn và tài khoản một cách hiệu quả.
                    </p>

                    <p>
                        <strong>© 2026 KMNCA</strong>
                    </p>

                </div>


                <!-- LIÊN KẾT -->
                <div class="footer-column">

                    <h3>Liên kết</h3>

                    <ul class="footer-list">

                        <li>
                            <a href="#">
                                Trang chủ
                            </a>
                        </li>

                        <li>
                            <a href="#">
                                Giới thiệu
                            </a>
                        </li>

                        <li>
                            <a href="#">
                                Sản phẩm
                            </a>
                        </li>

                        <li>
                            <a href="#">
                                Liên hệ
                            </a>
                        </li>

                    </ul>

                </div>


                <!-- QUY ĐỊNH -->
                <div class="footer-column">

                    <h3>Quy định</h3>

                    <ul class="footer-list">

                        <li>
                            <a href="#">
                                Điều khoản sử dụng
                            </a>
                        </li>

                        <li>
                            <a href="#">
                                Chính sách bảo mật
                            </a>
                        </li>

                        <li>
                            <a href="#">
                                Quy định mua hàng
                            </a>
                        </li>

                        <li>
                            <a href="#">
                                Chính sách bảo hành
                            </a>
                        </li>

                    </ul>

                </div>


                <!-- LIÊN HỆ -->
                <div class="footer-column">

                    <h3>Thông tin liên hệ</h3>

                    <div class="footer-contact-item">

                        <span class="footer-contact-icon">
                            📍
                        </span>

                        <p>
                            Hà Nội, Việt Nam
                        </p>

                    </div>


                    <div class="footer-contact-item">

                        <span class="footer-contact-icon">
                            ☎
                        </span>

                        <p>
                            <a href="tel:0987654321">
                                0987 654 321
                            </a>
                        </p>

                    </div>


                    <div class="footer-contact-item">

                        <span class="footer-contact-icon">
                            ✉
                        </span>

                        <p>
                            <a href="mailto:contact@kmnca.vn">
                                contact@kmnca.vn
                            </a>
                        </p>

                    </div>


                    <div class="footer-contact-item">

                        <span class="footer-contact-icon">
                            🕒
                        </span>

                        <p>
                            08:00 - 22:00<br />
                            Thứ 2 - Chủ nhật
                        </p>

                    </div>

                </div>

            </div>


            <div class="footer-divider"></div>


            <div class="footer-bottom">

                <div>
                    © 2026 KMNCA. All rights reserved.
                </div>

                <div class="footer-bottom-links">

                    <a href="#">
                        Điều khoản
                    </a>

                    <a href="#">
                        Bảo mật
                    </a>

                    <a href="#">
                        Hỗ trợ
                    </a>

                </div>

            </div>

        </div>

    </footer>

</main>


    <script>

        const pageContent = document.getElementById("page-content");


        async function loadContent(url, options = {}) {

            try {

                pageContent.innerHTML = `
                    <div class="loading">
                        <div class="loading-spinner"></div>
                        <div>Đang tải dữ liệu...</div>
                    </div>
                `;


                const response = await fetch(url, {
                    ...options,
                    redirect: "follow",
                    headers: {
                        "X-Requested-With": "XMLHttpRequest",
                        ...(options.headers || {})
                    }
                });


                const html = await response.text();


                console.log("URL:", url);
                console.log("Status:", response.status);
                console.log("Response:", html);


                if (html.trim() !== "") {

                    pageContent.innerHTML = html;

                }
                else {

                    pageContent.innerHTML = `
                        <div class="content-card">
                            <h3 style="color:red;">
                                Không có dữ liệu trả về
                            </h3>
                        </div>
                    `;

                }


                window.scrollTo({
                    top: 0,
                    behavior: "smooth"
                });


            }
            catch (error) {

                console.error("AJAX Error:", error);


                pageContent.innerHTML = `
                    <div class="content-card">

                        <h3 style="color:red;">
                            Đã xảy ra lỗi
                        </h3>

                        <p>
                            Không thể tải dữ liệu.
                        </p>

                        <p style="color:#777;">
                            ${error.message}
                        </p>

                    </div>
                `;

            }

        }


        document.addEventListener("click", function (e) {

            const link = e.target.closest("a");


            if (!link) {
                return;
            }


            if (link.classList.contains("logout-btn")) {
                return;
            }


            if (link.target === "_blank") {
                return;
            }


            if (link.href.startsWith("mailto:") ||
                link.href.startsWith("tel:")) {

                return;

            }


            if (link.classList.contains("ajax-menu") ||
                link.closest("#page-content")) {

                e.preventDefault();


                const url = link.href;


                if (url) {

                    loadContent(url);

                }

            }

        });


        document.addEventListener("submit", function (e) {

            const form = e.target;


            if (!form.closest("#page-content")) {
                return;
            }


            e.preventDefault();


            const formData = new FormData(form);


            let method = form.method
                ? form.method.toUpperCase()
                : "GET";


            let url = form.action;


            if (!url) {

                url = window.location.href;

            }


            if (method === "GET") {

                const params = new URLSearchParams();


                for (const [key, value] of formData.entries()) {

                    if (value !== "") {

                        params.append(key, value);

                    }

                }


                if (params.toString() !== "") {

                    const separator = url.includes("?")
                        ? "&"
                        : "?";

                    url += separator + params.toString();

                }


                loadContent(url);


                return;

            }


            loadContent(url, {

                method: method,

                body: formData

            });

        });

    </script>

</body>
</html>