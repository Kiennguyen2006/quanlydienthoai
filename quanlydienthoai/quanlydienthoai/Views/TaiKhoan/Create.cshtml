@model quanlydienthoai.Models.TaiKhoan

@{
    Layout = null;
    ViewData["Title"] = "Thêm tài khoản";
}

<div class="tk-form-page">

    <div class="tk-form-card">

        <div class="tk-form-header">
            <div>
                <h2>Thêm tài khoản</h2>
                <p>Nhập thông tin để tạo tài khoản mới</p>
            </div>

            <a asp-action="Index"
               class="tk-btn tk-back ajax-menu">
                Quay lại
            </a>
        </div>

        <div class="tk-form-body">

            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="tk-validation">
                </div>

                <div class="tk-form-grid">

                    <div class="tk-form-group">

                        <label>Mã tài khoản</label>

                        <input value="Tự động tạo"
                               class="tk-form-control"
                               readonly />

                        <small class="tk-help">
                            Mã tài khoản sẽ được hệ thống tự động tạo.
                        </small>

                    </div>

                    <div class="tk-form-group">

                        <label asp-for="TenDangNhap">
                            Tên đăng nhập
                            <span class="required">*</span>
                        </label>

                        <input asp-for="TenDangNhap"
                               class="tk-form-control"
                               autocomplete="off"
                               placeholder="Ví dụ: nguyenvana" />

                        <span asp-validation-for="TenDangNhap"
                              class="tk-error">
                        </span>

                    </div>

                    <div class="tk-form-group">

                        <label asp-for="MatKhau">
                            Mật khẩu
                            <span class="required">*</span>
                        </label>

                        <input asp-for="MatKhau"
                               type="password"
                               class="tk-form-control"
                               autocomplete="new-password"
                               placeholder="Nhập mật khẩu" />

                        <span asp-validation-for="MatKhau"
                              class="tk-error">
                        </span>

                    </div>

                    <div class="tk-form-group">

                        <label asp-for="Email">
                            Email
                            <span class="required">*</span>
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="tk-form-control"
                               autocomplete="off"
                               placeholder="example@gmail.com" />

                        <span asp-validation-for="Email"
                              class="tk-error">
                        </span>

                    </div>

                    <div class="tk-form-group">

                        <label asp-for="PhanQuyen">
                            Phân quyền
                            <span class="required">*</span>
                        </label>

                        <select asp-for="PhanQuyen"
                                class="tk-form-control">

                            <option value="">
                                -- Chọn phân quyền --
                            </option>

                            @foreach (var quyen in ViewBag.PhanQuyens)
                            {
                                <option value="@quyen">
                                    @quyen
                                </option>
                            }

                        </select>

                        <span asp-validation-for="PhanQuyen"
                              class="tk-error">
                        </span>

                    </div>

                    <div class="tk-form-group">

                        <label>Ngày tạo</label>

                        <input value="Tự động"
                               class="tk-form-control"
                               readonly />

                    </div>

                </div>

                <div class="tk-form-actions">

                    <button type="submit"
                            class="tk-btn tk-save">
                        Lưu tài khoản
                    </button>

                    <a asp-action="Index"
                       class="tk-btn tk-back ajax-menu">
                        Hủy
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

<style>

.tk-form-page {
    width: 100%;
    padding: 5px;
    box-sizing: border-box;
}

.tk-form-card {
    max-width: 950px;
    margin: 0 auto;
    background: #ffffff;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, .06);
    overflow: hidden;
}

.tk-form-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 22px 25px;
    border-bottom: 1px solid #edf0f4;
}

.tk-form-header h2 {
    margin: 0;
    color: #1f2937;
    font-size: 24px;
}

.tk-form-header p {
    margin: 6px 0 0;
    color: #6b7280;
    font-size: 14px;
}

.tk-form-body {
    padding: 25px;
}

.tk-validation {
    padding: 12px 15px;
    margin-bottom: 20px;
    border-radius: 8px;
    background: #fff5f5;
    color: #dc2626;
    font-size: 14px;
}

.tk-form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
}

.tk-form-group {
    display: flex;
    flex-direction: column;
}

.tk-form-group label {
    margin-bottom: 7px;
    color: #374151;
    font-size: 14px;
    font-weight: 600;
}

.required {
    color: #dc2626;
}

.tk-form-control {
    width: 100%;
    height: 43px;
    padding: 0 12px;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    outline: none;
    background: #ffffff;
    color: #1f2937;
    font-size: 14px;
    box-sizing: border-box;
    transition: .2s;
}

.tk-form-control:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, .10);
}

.tk-form-control[readonly] {
    background: #f3f4f6;
    color: #6b7280;
    cursor: not-allowed;
}

.tk-help {
    margin-top: 6px;
    color: #6b7280;
    font-size: 12px;
}

.tk-error {
    margin-top: 5px;
    color: #dc2626;
    font-size: 13px;
}

.tk-form-actions {
    display: flex;
    gap: 10px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid #edf0f4;
}

.tk-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0 18px;
    border: none;
    border-radius: 8px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    box-sizing: border-box;
    transition: .2s;
}

.tk-save {
    background: #2563eb;
    color: white;
}

.tk-save:hover {
    background: #1d4ed8;
}

.tk-back {
    background: #e5e7eb;
    color: #374151;
}

.tk-back:hover {
    background: #d1d5db;
}

@@media (max-width: 700px) {

    .tk-form-header {
        flex-direction: column;
        align-items: flex-start;
    }

    .tk-form-body {
        padding: 18px;
    }

    .tk-form-grid {
        grid-template-columns: 1fr;
    }

    .tk-form-actions {
        flex-direction: column;
    }

    .tk-btn {
        width: 100%;
    }
}

</style>