@model IEnumerable<quanlydienthoai.Models.TaiKhoan>

@{
    Layout = null;
    ViewData["Title"] = "Quản lý tài khoản";
}

<div class="tk-page">

    <div class="content-card">

        <div class="page-header">

            <div>
                <h2>Quản lý tài khoản</h2>
                <p>Quản lý tài khoản đăng nhập và phân quyền hệ thống</p>
            </div>

            <a asp-controller="TaiKhoan"
               asp-action="Create"
               class="btn-primary ajax-menu">
                + Thêm tài khoản
            </a>

        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert-success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["DeleteError"] != null)
        {
            <div class="alert-error">
                @TempData["DeleteError"]
            </div>
        }

        <form asp-controller="TaiKhoan"
              asp-action="Index"
              method="get"
              class="search-box">

            <input type="text"
                   name="timkiem"
                   value="@ViewBag.TimKiem"
                   placeholder="Tìm mã, tên đăng nhập, email, phân quyền..." />

            <button type="submit"
                    class="btn-search">
                Tìm kiếm
            </button>

            @if (!string.IsNullOrWhiteSpace(ViewBag.TimKiem))
            {
                <a asp-controller="TaiKhoan"
                   asp-action="Index"
                   class="btn-reset ajax-menu">
                    Xóa tìm kiếm
                </a>
            }

        </form>

        <div class="table-wrapper">

            <table class="data-table">

                <thead>
                    <tr>
                        <th>Mã tài khoản</th>
                        <th>Tên đăng nhập</th>
                        <th>Mật khẩu</th>
                        <th>Email</th>
                        <th>Phân quyền</th>
                        <th>Ngày tạo</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="empty-data">
                                Không có tài khoản nào.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>@item.MaTaiKhoan</strong>
                                </td>

                                <td>
                                    @item.TenDangNhap
                                </td>

                                <td>
                                    <span class="password-hidden">
                                        ********
                                    </span>
                                </td>

                                <td>
                                    @item.Email
                                </td>

                                <td>

                                    @if (item.PhanQuyen == "Admin")
                                    {
                                        <span class="badge badge-admin">
                                            Admin
                                        </span>
                                    }
                                    else if (item.PhanQuyen == "Quản lý")
                                    {
                                        <span class="badge badge-manager">
                                            Quản lý
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-staff">
                                            Nhân viên
                                        </span>
                                    }

                                </td>

                                <td>
                                    @item.NgayTao.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>

                                    <div class="action-buttons">

                                        <a asp-controller="TaiKhoan"
                                           asp-action="Details"
                                           asp-route-mataikhoan="@item.MaTaiKhoan"
                                           class="btn-detail ajax-menu">
                                            Xem
                                        </a>

                                        <a asp-controller="TaiKhoan"
                                           asp-action="Edit"
                                           asp-route-mataikhoan="@item.MaTaiKhoan"
                                           class="btn-edit ajax-menu">
                                            Sửa
                                        </a>

                                        <a asp-controller="TaiKhoan"
                                           asp-action="Delete"
                                           asp-route-mataikhoan="@item.MaTaiKhoan"
                                           class="btn-delete ajax-menu">
                                            Xóa
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<style>

.tk-page {
    width: 100%;
}

.content-card {
    background: #ffffff;
    border-radius: 14px;
    padding: 25px;
    box-shadow: 0 4px 18px rgba(0, 0, 0, .08);
}

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 22px;
}

.page-header h2 {
    margin: 0;
    font-size: 25px;
    color: #1f2937;
}

.page-header p {
    margin: 6px 0 0;
    color: #777;
    font-size: 14px;
}

.btn-primary,
.btn-search,
.btn-reset,
.btn-detail,
.btn-edit,
.btn-delete {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 9px 14px;
    min-height: 38px;
    box-sizing: border-box;
    border-radius: 7px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
}

.btn-primary {
    background: #007bff;
    color: white;
}

.btn-primary:hover {
    background: #0069d9;
}

.search-box {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
}

.search-box input {
    flex: 1;
    min-width: 0;
    padding: 11px 14px;
    border: 1px solid #ddd;
    border-radius: 7px;
    outline: none;
    font-size: 14px;
}

.search-box input:focus {
    border-color: #007bff;
}

.btn-search {
    background: #007bff;
    color: white;
}

.btn-search:hover {
    background: #0069d9;
}

.btn-reset {
    background: #eeeeee;
    color: #333333;
}

.btn-reset:hover {
    background: #dddddd;
}

.table-wrapper {
    width: 100%;
    overflow-x: auto;
}

.data-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 900px;
}

.data-table th {
    background: #f5f7fa;
    padding: 13px;
    text-align: left;
    white-space: nowrap;
    color: #374151;
    font-size: 14px;
}

.data-table td {
    padding: 13px;
    border-bottom: 1px solid #eeeeee;
    font-size: 14px;
    color: #374151;
}

.data-table tbody tr:hover {
    background: #fafafa;
}

.password-hidden {
    color: #777;
    letter-spacing: 1px;
}

.action-buttons {
    display: flex;
    gap: 6px;
    white-space: nowrap;
}

.btn-detail {
    background: #17a2b8;
    color: white;
}

.btn-detail:hover {
    background: #138496;
}

.btn-edit {
    background: #ffc107;
    color: #222;
}

.btn-edit:hover {
    background: #e0a800;
}

.btn-delete {
    background: #dc3545;
    color: white;
}

.btn-delete:hover {
    background: #c82333;
}

.badge {
    display: inline-block;
    padding: 5px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
}

.badge-admin {
    background: #ffe0e0;
    color: #c00000;
}

.badge-manager {
    background: #fff0c2;
    color: #946b00;
}

.badge-staff {
    background: #dff3ff;
    color: #006d9c;
}

.alert-success {
    padding: 12px 15px;
    margin-bottom: 15px;
    background: #dff6e5;
    color: #176b2c;
    border-radius: 7px;
}

.alert-error {
    padding: 12px 15px;
    margin-bottom: 15px;
    background: #ffe1e1;
    color: #a40000;
    border-radius: 7px;
}

.empty-data {
    text-align: center;
    padding: 35px !important;
    color: #888;
}

@@media (max-width: 700px) {

    .content-card {
        padding: 18px;
    }

    .page-header {
        flex-direction: column;
        align-items: flex-start;
    }

    .search-box {
        flex-direction: column;
    }

    .search-box input,
    .btn-search,
    .btn-reset {
        width: 100%;
    }

    .action-buttons {
        flex-direction: column;
    }

    .action-buttons a {
        width: 100%;
    }
}

</style>