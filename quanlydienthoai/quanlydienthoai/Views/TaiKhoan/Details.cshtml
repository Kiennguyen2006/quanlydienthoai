@model quanlydienthoai.Models.TaiKhoan

@{
    Layout = null;
    ViewData["Title"] = "Chi tiết tài khoản";
}

<div class="content-card">

    <div class="page-header">
        <div>
            <h2>Chi tiết tài khoản</h2>
            <p>Xem thông tin chi tiết tài khoản người dùng</p>
        </div>
    </div>

    <div class="detail-grid">

        <div class="detail-item">
            <span class="detail-label">
                Mã tài khoản
            </span>
            <span class="detail-value">
                @Model.MaTaiKhoan
            </span>
        </div>

        <div class="detail-item">
            <span class="detail-label">
                Tên đăng nhập
            </span>
            <span class="detail-value">
                @Model.TenDangNhap
            </span>
        </div>

        <div class="detail-item">
            <span class="detail-label">
                Email
            </span>
            <span class="detail-value">
                @Model.Email
            </span>
        </div>

        <div class="detail-item">
            <span class="detail-label">
                Phân quyền
            </span>
            <span class="detail-value">
                @Model.PhanQuyen
            </span>
        </div>

        <div class="detail-item full-width">
            <span class="detail-label">
                Ngày tạo
            </span>
            <span class="detail-value">
    @Model.NgayTao.ToString("dd/MM/yyyy HH:mm")
</span>
        </div>

    </div>

    <div class="form-actions">
        <a asp-action="Edit"
           asp-route-mataikhoan="@Model.MaTaiKhoan"
           class="btn-edit ajax-menu">
            Chỉnh sửa
        </a>

        <a asp-action="Index"
           class="btn-secondary ajax-menu">
            Quay lại
        </a>
    </div>

</div>

<style>
    .content-card {
        background: #fff;
        border-radius: 16px;
        padding: 28px;
        box-shadow: 0 4px 18px rgba(0,0,0,.08);
        max-width: 850px;
        margin: auto;
    }

    .page-header {
        margin-bottom: 25px;
    }

        .page-header h2 {
            margin: 0;
            color: #1f2937;
        }

        .page-header p {
            color: #6b7280;
            margin-top: 6px;
        }

    .detail-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
    }

    .detail-item {
        display: flex;
        flex-direction: column;
        padding: 16px;
        background: #f8fafc;
        border-radius: 10px;
        border: 1px solid #e5e7eb;
    }

    .detail-label {
        font-size: 13px;
        color: #6b7280;
        margin-bottom: 6px;
    }

    .detail-value {
        font-size: 15px;
        font-weight: 600;
        color: #1f2937;
        word-break: break-word;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 28px;
    }

    .btn-edit,
    .btn-secondary {
        display: inline-block;
        padding: 11px 22px;
        border-radius: 8px;
        text-decoration: none;
        border: none;
        cursor: pointer;
        font-weight: 600;
        font-size: 14px;
        transition: 0.2s ease;
    }

    .btn-edit {
        background: #0d6efd;
        color: white !important;
    }

    .btn-edit:hover {
        background: #0b5ed7;
    }

    .btn-secondary {
        background: #6c757d;
        color: white !important;
    }

    .btn-secondary:hover {
        background: #5c636a;
    }

    @@media (max-width: 700px) {
        .detail-grid {
            grid-template-columns: 1fr;
        }

        .full-width {
            grid-column: auto;
        }
    }
</style>