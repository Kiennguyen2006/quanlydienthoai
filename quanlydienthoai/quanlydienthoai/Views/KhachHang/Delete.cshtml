@model quanlydienthoai.Models.KhachHang

@{
    Layout = null;
    ViewData["Title"] = "Xóa khách hàng";
}

<div class="kh-delete-container">

    <div class="kh-delete-card">

        <h2 class="kh-delete-title">
            Xóa khách hàng
        </h2>

        <div class="kh-warning">
            Bạn có chắc chắn muốn xóa khách hàng này không?
            Thao tác này sẽ xóa khách hàng khỏi hệ thống và không thể hoàn tác.
        </div>

        @if (TempData["KhachHangDeleteError"] is string deleteError)
        {
            <div class="alert-error" role="alert">
                @deleteError
            </div>
        }

        <div class="kh-info">

            <div class="kh-info-label">
                Mã khách hàng
            </div>
            <div class="kh-info-value">
                @Model.MaKhachHang
            </div>

            <div class="kh-info-label">
                Họ tên
            </div>
            <div class="kh-info-value">
                @Model.HoTen
            </div>

            <div class="kh-info-label">
                Số điện thoại
            </div>
            <div class="kh-info-value">
                @Model.SoDienThoai
            </div>

            <div class="kh-info-label">
                Email
            </div>
            <div class="kh-info-value">
                @Model.Email
            </div>

        </div>

        <form asp-controller="KhachHang"
              asp-action="Delete"
              asp-route-makhachhang="@Model.MaKhachHang"
              method="post">

            @Html.AntiForgeryToken()

            <div class="kh-actions">

                <button type="submit"
                        class="kh-btn kh-btn-danger">
                    Xác nhận xóa
                </button>

                <a asp-controller="KhachHang"
                   asp-action="Index"
                   class="kh-btn kh-btn-secondary ajax-menu">
                    Hủy
                </a>

            </div>

        </form>

    </div>

</div>

<style>
    .kh-delete-container {
        padding: 25px;
        max-width: 650px;
        margin: auto;
    }

    .kh-delete-card {
        background: white;
        border-radius: 14px;
        padding: 30px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.08);
    }

    .kh-delete-title {
        color: #dc3545;
        margin-top: 0;
        margin-bottom: 10px;
    }

    .kh-warning {
        background: #fff4f4;
        color: #b42318;
        border: 1px solid #ffd0d0;
        padding: 14px;
        border-radius: 8px;
        margin: 20px 0;
        font-weight: 500;
    }

    .alert-error {
        padding: 12px 15px;
        margin-bottom: 20px;
        background: #ffe1e1;
        color: #a40000;
        border-radius: 8px;
        border: 1px solid #f5c2c7;
        font-weight: 500;
    }

    .kh-info {
        display: grid;
        grid-template-columns: 160px 1fr;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        overflow: hidden;
    }

    .kh-info-label {
        padding: 13px 15px;
        font-weight: 600;
        background: #f8fafc;
        border-bottom: 1px solid #e5e7eb;
        color: #4b5563;
    }

    .kh-info-value {
        padding: 13px 15px;
        border-bottom: 1px solid #e5e7eb;
        color: #1f2937;
        font-weight: 500;
        word-break: break-word;
    }

    .kh-info > div:nth-last-child(-n+2) {
        border-bottom: none;
    }

    .kh-actions {
        display: flex;
        gap: 10px;
        margin-top: 25px;
    }

    .kh-btn {
        border: none;
        text-decoration: none;
        padding: 11px 20px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        display: inline-block;
    }

    .kh-btn-danger {
        background: #dc3545;
        color: white;
    }

    .kh-btn-danger:hover {
        background: #bb2d3b;
    }

    .kh-btn-secondary {
        background: #6c757d;
        color: white;
    }

    .kh-btn-secondary:hover {
        background: #5c636a;
    }

    @@media (max-width: 600px) {
        .kh-info {
            grid-template-columns: 1fr;
        }
        
        .kh-info-label {
            border-bottom: none;
            padding-bottom: 4px;
        }

        .kh-info-value {
            padding-top: 4px;
        }
    }
</style>