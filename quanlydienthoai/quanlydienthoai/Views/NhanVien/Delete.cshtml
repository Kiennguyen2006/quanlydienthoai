@model quanlydienthoai.Models.NhanVien

@{
    Layout = null;
    ViewData["Title"] = "Xóa nhân viên";
}

<style>
    .nv-delete-page {
        padding: 25px;
        background: #f5f7fb;
        min-height: 100vh;
    }

    .nv-delete-card {
        max-width: 600px;
        margin: 50px auto;
        background: white;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 4px 18px rgba(0,0,0,.08);
        text-align: center;
    }

    .nv-warning {
        width: 60px;
        height: 60px;
        margin: 0 auto 15px;
        border-radius: 50%;
        background: #fee2e2;
        color: #dc2626;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        font-weight: bold;
    }

    .nv-delete-card h2 {
        color: #111827;
        margin-bottom: 10px;
    }

    .nv-delete-card p {
        color: #6b7280;
    }

    .nv-delete-info {
        margin: 20px 0;
        padding: 15px;
        background: #f9fafb;
        border-radius: 10px;
        text-align: left;
    }

        .nv-delete-info strong {
            display: block;
            color: #111827;
            font-size: 18px;
            margin-bottom: 8px;
            text-align: center;
        }

    .nv-delete-buttons {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-top: 20px;
    }

    .nv-btn {
        padding: 11px 18px;
        border-radius: 8px;
        text-decoration: none;
        border: none;
        font-weight: 600;
        cursor: pointer;
    }

    .nv-confirm {
        background: #dc2626;
        color: white;
    }

    .nv-back {
        background: #e5e7eb;
        color: #374151;
    }

    .nv-error {
        margin-bottom: 15px;
        padding: 12px;
        background: #fee2e2;
        color: #b91c1c;
        border-radius: 8px;
        font-weight: 500;
    }
</style>

<div class="nv-delete-page">

    <div class="nv-delete-card">

        <div class="nv-warning">
            !
        </div>

        <h2>Xác nhận xóa nhân viên</h2>

        <p>
            Bạn có chắc chắn muốn xóa nhân viên này không?
        </p>

        @if (TempData["DeleteError"] != null)
        {
            <div class="nv-error">
                @TempData["DeleteError"]
            </div>
        }

        <div class="nv-delete-info">
            <strong>
                @Model.HoTen
            </strong>
            <div>
                <strong>Mã nhân viên:</strong> @Model.MaNhanVien
            </div>
            <div>
                <strong>Chức vụ:</strong> @Model.ChucVu
            </div>
        </div>

        <form asp-action="Delete"
              asp-route-manhanvien="@Model.MaNhanVien"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="MaNhanVien" />

            <div class="nv-delete-buttons">

                <button type="submit"
                        class="nv-btn nv-confirm">
                    Xác nhận xóa
                </button>

                <a asp-action="Index"
                   class="nv-btn nv-back ajax-menu">
                    Hủy
                </a>

            </div>

        </form>

    </div>

</div>