@model quanlydienthoai.Models.SanPham

@{
    Layout = null;
    ViewData["Title"] = "Sửa sản phẩm";
}

<style>
    .sp-form-page {
        padding: 25px;
        background: #f5f7fb;
        min-height: 100vh;
    }

    .sp-form-card {
        max-width: 1100px;
        margin: auto;
        background: white;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 5px 20px rgba(0,0,0,.08);
    }

    .sp-form-title {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 25px;
        color: #1f2937;
    }

    .sp-form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px 28px;
    }

    .sp-form-group {
        display: flex;
        flex-direction: column;
    }

    .sp-form-group.full {
        grid-column: 1 / -1;
    }

    .sp-form-group label {
        font-weight: 600;
        margin-bottom: 8px;
        color: #374151;
    }

    .required {
        color: #dc2626;
    }

    .sp-form-control {
        width: 100%;
        padding: 12px 14px;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        font-size: 15px;
        outline: none;
        box-sizing: border-box;
    }

    .sp-form-control:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37,99,235,.1);
    }

    textarea.sp-form-control {
        min-height: 130px;
        resize: vertical;
    }

    .text-danger {
        color: #dc2626;
        font-size: 14px;
        margin-top: 5px;
    }

    .image-box {
        margin-bottom: 10px;
    }

    .current-image {
        width: 160px;
        height: 160px;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid #ddd;
    }

    .no-image {
        width: 160px;
        height: 160px;
        border: 1px dashed #bbb;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #777;
        background: #f8f9fa;
    }

    .image-note {
        margin-top: 6px;
        color: #6b7280;
        font-size: 14px;
    }

    .sp-buttons {
        display: flex;
        gap: 12px;
        margin-top: 25px;
    }

    .btn-sp {
        border: none;
        border-radius: 9px;
        padding: 11px 22px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
    }

    .btn-save {
        background: #2563eb;
        color: white;
    }

    .btn-save:hover {
        background: #1d4ed8;
    }

    .btn-back {
        background: #e5e7eb;
        color: #374151;
    }

    .btn-back:hover {
        background: #d1d5db;
    }

    .validation-summary {
        color: #dc2626;
        margin-bottom: 15px;
    }

    @@media (max-width: 768px) {
        .sp-form-grid {
            grid-template-columns: 1fr;
        }

        .sp-form-group.full {
            grid-column: auto;
        }
    }
</style>

<div class="sp-form-page">
    <div class="sp-form-card">

        <div class="sp-form-title">
            Sửa sản phẩm
        </div>

        <div asp-validation-summary="ModelOnly"
             class="validation-summary"></div>

        <form asp-action="Edit"
              asp-route-masanpham="@Model.MaSanPham"
              method="post"
              enctype="multipart/form-data">

            <input type="hidden"
                   asp-for="MaSanPham" />

            <div class="sp-form-grid">

                <div class="sp-form-group">
                    <label>
                        Nhà cung cấp <span class="required">*</span>
                    </label>

                    <select asp-for="MaNhaCungCap"
                            asp-items="ViewBag.MaNhaCungCap"
                            class="sp-form-control">
                        <option value="">-- Chọn nhà cung cấp --</option>
                    </select>

                    <span asp-validation-for="MaNhaCungCap"
                          class="text-danger"></span>
                </div>

                <div class="sp-form-group">
                    <label>
                        Tên sản phẩm <span class="required">*</span>
                    </label>

                    <input asp-for="TenSanPham"
                           class="sp-form-control" />

                    <span asp-validation-for="TenSanPham"
                          class="text-danger"></span>
                </div>

                <div class="sp-form-group">
                    <label>
                        Hãng sản xuất <span class="required">*</span>
                    </label>

                    <input asp-for="HangSanXuat"
                           class="sp-form-control" />

                    <span asp-validation-for="HangSanXuat"
                          class="text-danger"></span>
                </div>

                <div class="sp-form-group">
                    <label>
                        Model <span class="required">*</span>
                    </label>

                    <input asp-for="Model"
                           class="sp-form-control" />

                    <span asp-validation-for="Model"
                          class="text-danger"></span>
                </div>

                <div class="sp-form-group">
                    <label>
                        Giá nhập <span class="required">*</span>
                    </label>

                    <input asp-for="GiaNhap"
                           type="number"
                           step="0.01"
                           class="sp-form-control" />

                    <span asp-validation-for="GiaNhap"
                          class="text-danger"></span>
                </div>

                <div class="sp-form-group">
                    <label>
                        Giá bán <span class="required">*</span>
                    </label>

                    <input asp-for="GiaBan"
                           type="number"
                           step="0.01"
                           class="sp-form-control" />

                    <span asp-validation-for="GiaBan"
                          class="text-danger"></span>
                </div>

                <div class="sp-form-group">
                    <label>
                        Số lượng <span class="required">*</span>
                    </label>

                    <input asp-for="SoLuong"
                           type="number"
                           class="sp-form-control" />

                    <span asp-validation-for="SoLuong"
                          class="text-danger"></span>
                </div>

                <div class="sp-form-group">
                    <label>
                        Màu sắc <span class="required">*</span>
                    </label>

                    <input asp-for="MauSac"
                           class="sp-form-control" />

                    <span asp-validation-for="MauSac"
                          class="text-danger"></span>
                </div>

                <div class="sp-form-group">
                    <label>
                        RAM <span class="required">*</span>
                    </label>

                    <input asp-for="Ram"
                           class="sp-form-control" />

                    <span asp-validation-for="Ram"
                          class="text-danger"></span>
                </div>

                <div class="sp-form-group">
                    <label>
                        ROM <span class="required">*</span>
                    </label>

                    <input asp-for="Rom"
                           class="sp-form-control" />

                    <span asp-validation-for="Rom"
                          class="text-danger"></span>
                </div>

                <div class="sp-form-group">
                    <label>
                        Chip <span class="required">*</span>
                    </label>

                    <input asp-for="Chip"
                           class="sp-form-control" />

                    <span asp-validation-for="Chip"
                          class="text-danger"></span>
                </div>

                <div class="sp-form-group">
                    <label>
                        CPU <span class="required">*</span>
                    </label>

                    <input asp-for="Cpu"
                           class="sp-form-control" />

                    <span asp-validation-for="Cpu"
                          class="text-danger"></span>
                </div>

                <div class="sp-form-group">
                    <label>
                        GPU <span class="required">*</span>
                    </label>

                    <input asp-for="Gpu"
                           class="sp-form-control" />

                    <span asp-validation-for="Gpu"
                          class="text-danger"></span>
                </div>

                <div class="sp-form-group">
                    <label>
                        Màn hình <span class="required">*</span>
                    </label>

                    <input asp-for="ManHinh"
                           class="sp-form-control" />

                    <span asp-validation-for="ManHinh"
                          class="text-danger"></span>
                </div>

                <div class="sp-form-group">
                    <label>
                        Camera <span class="required">*</span>
                    </label>

                    <input asp-for="Camera"
                           class="sp-form-control" />

                    <span asp-validation-for="Camera"
                          class="text-danger"></span>
                </div>

                <div class="sp-form-group">
                    <label>
                        Pin <span class="required">*</span>
                    </label>

                    <input asp-for="Pin"
                           class="sp-form-control" />

                    <span asp-validation-for="Pin"
                          class="text-danger"></span>
                </div>

                <div class="sp-form-group">
                    <label>
                        Hệ điều hành <span class="required">*</span>
                    </label>

                    <input asp-for="HeDieuHanh"
                           class="sp-form-control" />

                    <span asp-validation-for="HeDieuHanh"
                          class="text-danger"></span>
                </div>

                <div class="sp-form-group full">
                    <label>
                        Ảnh hiện tại
                    </label>

                    <div class="image-box">
                        @if (!string.IsNullOrWhiteSpace(Model.Anh))
                        {
                            <img src="~/images/@Model.Anh"
                                 class="current-image"
                                 alt="@Model.TenSanPham" />
                        }
                        else
                        {
                            <div class="no-image">
                                Chưa có ảnh
                            </div>
                        }
                    </div>
                </div>

                <div class="sp-form-group full">
                    <label>
                        Chọn ảnh mới
                    </label>

                    <input type="file"
                           name="fileAnh"
                           id="fileAnh"
                           class="sp-form-control"
                           accept=".jpg,.jpeg,.png,.webp" />

                    <div class="image-note">
                        Không chọn ảnh mới thì giữ ảnh hiện tại.
                        Chỉ chọn JPG, JPEG, PNG hoặc WEBP. Dung lượng tối đa 20MB.
                    </div>

                    @if (ViewData.ModelState["fileAnh"]?.Errors.Count > 0)
                    {
                        <span class="text-danger">
                            @ViewData.ModelState["fileAnh"]!.Errors[0].ErrorMessage
                        </span>
                    }
                </div>

                <div class="sp-form-group full">
                    <label>
                        Mô tả <span class="required">*</span>
                    </label>

                    <textarea asp-for="MoTa"
                              class="sp-form-control"></textarea>

                    <span asp-validation-for="MoTa"
                          class="text-danger"></span>
                </div>

            </div>

            <div class="sp-buttons">
                <button type="submit"
                        class="btn-sp btn-save">
                    Lưu thay đổi
                </button>

                <a asp-controller="SanPham"
                   asp-action="Index"
                   class="btn-sp btn-back ajax-menu">
                    Quay lại
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}