@model IEnumerable<quanlydienthoai.Models.SanPham>

@{
    Layout = null;
    ViewData["Title"] = "Quản lý sản phẩm";
}

<style>
    .content-card {
        background: #fff;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 4px 18px rgba(0,0,0,.08);
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 22px;
    }

    .page-header h2 {
        margin: 0;
        font-size: 25px;
        color: #1f2937;
    }

    .page-header p {
        margin: 6px 0 0;
        color: #6b7280;
    }

    .btn-primary {
        background: #007bff;
        color: white !important;
        padding: 11px 18px;
        border-radius: 8px;
        text-decoration: none;
        border: none;
        cursor: pointer;
        font-weight: 600;
    }

    .btn-primary:hover {
        background: #0069d9;
    }

    .search-box {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
    }

    .search-box input {
        flex: 1;
        padding: 11px 14px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        outline: none;
    }

    .btn-search,
    .btn-reset {
        padding: 10px 16px;
        border-radius: 8px;
        text-decoration: none;
        border: none;
        cursor: pointer;
    }

    .btn-search {
        background: #198754;
        color: white;
    }

    .btn-reset {
        background: #6c757d;
        color: white;
    }

    .table-wrapper {
        overflow-x: auto;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1300px;
    }

    .data-table th {
        background: #f3f6fa;
        color: #374151;
        padding: 13px;
        text-align: left;
        white-space: nowrap;
    }

    .data-table td {
        padding: 12px;
        border-top: 1px solid #e5e7eb;
        vertical-align: middle;
    }

    .data-table tr:hover {
        background: #f8fafc;
    }

    .product-image {
        width: 65px;
        height: 65px;
        object-fit: cover;
        border-radius: 9px;
        border: 1px solid #e5e7eb;
    }

    .no-image {
        width: 65px;
        height: 65px;
        border-radius: 9px;
        background: #f1f3f5;
        color: #9ca3af;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
    }

    .price {
        white-space: nowrap;
        font-weight: 600;
    }

    .quantity {
        text-align: center;
        font-weight: 600;
    }

    .action-group {
        display: flex;
        gap: 6px;
        white-space: nowrap;
    }

    .btn-detail,
    .btn-edit,
    .btn-delete {
        padding: 7px 11px;
        border-radius: 6px;
        color: white !important;
        text-decoration: none;
        font-size: 13px;
    }

    .btn-detail {
        background: #17a2b8;
    }

    .btn-edit {
        background: #ffc107;
        color: #212529 !important;
    }

    .btn-delete {
        background: #dc3545;
    }

    .alert {
        padding: 12px 15px;
        border-radius: 8px;
        margin-bottom: 18px;
    }

    .alert-success {
        background: #d1e7dd;
        color: #0f5132;
    }

    .alert-danger {
        background: #f8d7da;
        color: #842029;
    }

    @@media (max-width: 768px) {
        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .search-box {
            flex-direction: column;
        }
    }
</style>

<div class="content-card">

    <div class="page-header">
        <div>
            <h2>Quản lý sản phẩm</h2>
            <p>Quản lý thông tin điện thoại và sản phẩm trong cửa hàng</p>
        </div>

        <a asp-controller="SanPham"
           asp-action="Create"
           class="btn-primary ajax-menu">
            + Thêm sản phẩm
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["DeleteError"] != null)
    {
        <div class="alert alert-danger">
            @TempData["DeleteError"]
        </div>
    }

    <form asp-action="Index"
          method="get"
          class="search-box">

        <input type="text"
               name="timkiem"
               value="@ViewBag.TimKiem"
               placeholder="Tìm mã sản phẩm, tên, hãng, model, RAM, ROM..." />

        <button type="submit"
                class="btn-search">
            Tìm kiếm
        </button>

        @if (!string.IsNullOrWhiteSpace(ViewBag.TimKiem))
        {
            <a asp-action="Index"
               class="btn-reset ajax-menu">
                Xóa
            </a>
        }
    </form>

    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Ảnh</th>
                    <th>Mã SP</th>
                    <th>Nhà cung cấp</th>
                    <th>Tên sản phẩm</th>
                    <th>Hãng</th>
                    <th>Model</th>
                    <th>Giá nhập</th>
                    <th>Giá bán</th>
                    <th>Số lượng</th>
                    <th>RAM</th>
                    <th>ROM</th>
                    <th>Hệ điều hành</th>
                    <th>Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.Anh))
                            {
                                <img src="~/images/@item.Anh"
                                     class="product-image"
                                     alt="@item.TenSanPham" />
                            }
                            else
                            {
                                <div class="no-image">
                                    Không có ảnh
                                </div>
                            }
                        </td>

                        <td>@item.MaSanPham</td>

                        <td>
                            @item.MaNhaCungCapNavigation?.TenNhaCungCap
                        </td>

                        <td>
                            <strong>@item.TenSanPham</strong>
                        </td>

                        <td>@item.HangSanXuat</td>

                        <td>@item.Model</td>

                        <td class="price">
                            @item.GiaNhap.ToString("N0") đ
                        </td>

                        <td class="price">
                            @item.GiaBan.ToString("N0") đ
                        </td>

                        <td class="quantity">
                            @item.SoLuong
                        </td>

                        <td>@item.Ram</td>

                        <td>@item.Rom</td>

                        <td>@item.HeDieuHanh</td>

                        <td>
                            <div class="action-group">

                                <a asp-action="Details"
                                   asp-route-masanpham="@item.MaSanPham"
                                   class="btn-detail ajax-menu">
                                    Xem
                                </a>

                                <a asp-action="Edit"
                                   asp-route-masanpham="@item.MaSanPham"
                                   class="btn-edit ajax-menu">
                                    Sửa
                                </a>

                                <a asp-action="Delete"
                                   asp-route-masanpham="@item.MaSanPham"
                                   class="btn-delete ajax-menu">
                                    Xóa
                                </a>

                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>